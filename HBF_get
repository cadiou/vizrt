' ---------------------------------------------------------------------
' FORMATAGE latest_time UTC -> HEURE DE PARIS
'
' Entrée attendue :
'   2026-06-25 09:18:25
' ou
'   2026-06-25T09:18:25
'
' Sortie :
'   25/06/2026 11:18:25
' ---------------------------------------------------------------------

Function FormatLatestTimeParis(sUtc as String) as String

	FormatLatestTimeParis = ""

	if sUtc.length < 10 then
		exit function
	end if

	dim y as integer
	dim m as integer
	dim d as integer
	dim h as integer
	dim mn as integer
	dim sec as integer

	y = 0
	m = 0
	d = 0
	h = 0
	mn = 0
	sec = 0


	' ---------------------------------------------------------
	' Cas 1 : format ISO
	' 2026-06-30 09:18:25
	' 2026-06-30T09:18:25
	' ---------------------------------------------------------

	if sUtc.GetSubstring(4, 1) = "-" then

		y   = (integer) sUtc.GetSubstring(0, 4)
		m   = (integer) sUtc.GetSubstring(5, 2)
		d   = (integer) sUtc.GetSubstring(8, 2)

		if sUtc.length >= 19 then
			h   = (integer) sUtc.GetSubstring(11, 2)
			mn  = (integer) sUtc.GetSubstring(14, 2)
			sec = (integer) sUtc.GetSubstring(17, 2)
		end if


	' ---------------------------------------------------------
	' Cas 2 : format français déjà en JJ/MM/AAAA
	' 30/06/2026 09:18:25
	' ---------------------------------------------------------

	elseif sUtc.GetSubstring(2, 1) = "/" then

		d   = (integer) sUtc.GetSubstring(0, 2)
		m   = (integer) sUtc.GetSubstring(3, 2)
		y   = (integer) sUtc.GetSubstring(6, 4)

		if sUtc.length >= 19 then
			h   = (integer) sUtc.GetSubstring(11, 2)
			mn  = (integer) sUtc.GetSubstring(14, 2)
			sec = (integer) sUtc.GetSubstring(17, 2)
		end if

	else

		' Format non reconnu
		FormatLatestTimeParis = sUtc
		exit function

	end if


	' ---------------------------------------------------------
	' Sécurité date
	' ---------------------------------------------------------

	if y < 1900 or m < 1 or m > 12 or d < 1 or d > 31 then
		FormatLatestTimeParis = sUtc
		exit function
	end if


	' ---------------------------------------------------------
	' Ajout offset Paris : UTC+2 été, UTC+1 hiver
	' ---------------------------------------------------------

	if IsParisSummerTimeUTC(y, m, d, h) then
		h = h + 2
	else
		h = h + 1
	end if


	' ---------------------------------------------------------
	' Passage au jour suivant
	' ---------------------------------------------------------

	if h >= 24 then

		h = h - 24
		d = d + 1

		if d > DaysInMonth(y, m) then
			d = 1
			m = m + 1

			if m > 12 then
				m = 1
				y = y + 1
			end if
		end if

	end if


	FormatLatestTimeParis = TwoDigits(d) & "/" & TwoDigits(m) & "/" & y & " " & TwoDigits(h) & ":" & TwoDigits(mn) & ":" & TwoDigits(sec)

End Function


' ---------------------------------------------------------------------
' DÉTECTION HEURE D'ÉTÉ PARIS
'
' Règle Europe :
' - début : dernier dimanche de mars à 01:00 UTC
' - fin   : dernier dimanche d'octobre à 01:00 UTC
' ---------------------------------------------------------------------

Function IsParisSummerTimeUTC(y as integer, m as integer, d as integer, h as integer) as boolean

	IsParisSummerTimeUTC = false

	if m > 3 and m < 10 then
		IsParisSummerTimeUTC = true
		exit function
	end if

	if m < 3 or m > 10 then
		IsParisSummerTimeUTC = false
		exit function
	end if

	dim lastSunday as integer

	if m = 3 then

		lastSunday = LastSundayOfMonth(y, 3)

		if d > lastSunday then
			IsParisSummerTimeUTC = true
		elseif d < lastSunday then
			IsParisSummerTimeUTC = false
		else
			if h >= 1 then
				IsParisSummerTimeUTC = true
			else
				IsParisSummerTimeUTC = false
			end if
		end if

		exit function

	end if

	if m = 10 then

		lastSunday = LastSundayOfMonth(y, 10)

		if d < lastSunday then
			IsParisSummerTimeUTC = true
		elseif d > lastSunday then
			IsParisSummerTimeUTC = false
		else
			if h < 1 then
				IsParisSummerTimeUTC = true
			else
				IsParisSummerTimeUTC = false
			end if
		end if

		exit function

	end if

End Function


' ---------------------------------------------------------------------
' DERNIER DIMANCHE DU MOIS
' ---------------------------------------------------------------------

Function LastSundayOfMonth(y as integer, m as integer) as integer

	dim lastDay as integer
	dim dow as integer

	lastDay = DaysInMonth(y, m)

	' 0 = dimanche, 1 = lundi, etc.
	dow = DayOfWeek(y, m, lastDay)

	LastSundayOfMonth = lastDay - dow

End Function


' ---------------------------------------------------------------------
' JOUR DE LA SEMAINE
'
' Retour :
' 0 = dimanche
' 1 = lundi
' 2 = mardi
' 3 = mercredi
' 4 = jeudi
' 5 = vendredi
' 6 = samedi
' ---------------------------------------------------------------------

Function DayOfWeek(y as integer, m as integer, d as integer) as integer

	dim yy as integer
	yy = y

	if m < 3 then
		yy = yy - 1
	end if

	DayOfWeek = (yy + IntDiv(yy, 4) - IntDiv(yy, 100) + IntDiv(yy, 400) + MonthCode(m) + d) mod 7

End Function


Function MonthCode(m as integer) as integer

	MonthCode = 0

	if m = 1 then
		MonthCode = 0
	elseif m = 2 then
		MonthCode = 3
	elseif m = 3 then
		MonthCode = 2
	elseif m = 4 then
		MonthCode = 5
	elseif m = 5 then
		MonthCode = 0
	elseif m = 6 then
		MonthCode = 3
	elseif m = 7 then
		MonthCode = 5
	elseif m = 8 then
		MonthCode = 1
	elseif m = 9 then
		MonthCode = 4
	elseif m = 10 then
		MonthCode = 6
	elseif m = 11 then
		MonthCode = 2
	elseif m = 12 then
		MonthCode = 4
	end if

End Function


Function DaysInMonth(y as integer, m as integer) as integer

	DaysInMonth = 31

	if m = 2 then

		if IsLeapYear(y) then
			DaysInMonth = 29
		else
			DaysInMonth = 28
		end if

	elseif m = 4 or m = 6 or m = 9 or m = 11 then

		DaysInMonth = 30

	end if

End Function


Function IsLeapYear(y as integer) as boolean

	IsLeapYear = false

	if y mod 400 = 0 then
		IsLeapYear = true
	elseif y mod 100 = 0 then
		IsLeapYear = false
	elseif y mod 4 = 0 then
		IsLeapYear = true
	end if

End Function


Function IntDiv(a as integer, b as integer) as integer

	IntDiv = (a - (a mod b)) / b

End Function


Function TwoDigits(n as integer) as String

	if n < 10 then
		TwoDigits = "0" & n
	else
		TwoDigits = "" & n
	end if

End Function


' ---------------------------------------------------------------------
' FORMATAGE NUMÉRIQUE
'
' Paramètre :
'   0 = valeur exacte
'   1 = ,00
'   2 = ,0000
'
' Exemple :
'   8395.330078125 -> 8395,33
'   8395.330078125 -> 8395,3301
' ---------------------------------------------------------------------

Function FormatNumericValue(sIn as String) as String

	FormatNumericValue = sIn

	if sIn = "" then
		exit function
	end if

	dim iFormat as Integer
	iFormat = GetParameterInt("format_numerique")

	' 0 = valeur exacte
	if iFormat = 0 then
		FormatNumericValue = sIn
		exit function
	end if

	if IsNumericText(sIn) = false then
		FormatNumericValue = sIn
		exit function
	end if

	dim digits as Integer

	if iFormat = 1 then
		digits = 2
	elseif iFormat = 2 then
		digits = 4
	else
		FormatNumericValue = sIn
		exit function
	end if

	FormatNumericValue = FormatDecimalFrench(sIn, digits)

End Function


Function FormatNumericPercentValue(sIn as String) as String

	FormatNumericPercentValue = sIn

	if sIn = "" then
		exit function
	end if

	dim iFormat as Integer
	iFormat = GetParameterInt("format_numerique")

	' Seuls les formats ,00 et ,0000 déclenchent la conversion en %.
	' Les autres formats, y compris majuscule, gardent la valeur brute.
	if IsDecimalFormatSelected() = false then
		FormatNumericPercentValue = sIn
		exit function
	end if

	if IsNumericText(sIn) = false then
		FormatNumericPercentValue = sIn
		exit function
	end if

	dim sClean as String
	dim v as Double
	dim sPercent as String

	sClean = NormalizeDecimalString(sIn)
	v = (Double) sClean

	' Conversion relatif -> pourcentage
	v = v * 100.0

	sPercent = "" & v

	FormatNumericPercentValue = FormatNumericValue(sPercent)

End Function


Function FormatDecimalFrench(sIn as String, digits as Integer) as String

	dim sClean as String
	dim v as Double
	dim factorInt as Integer
	dim scaled as Integer
	dim scaledAbs as Integer
	dim integerPart as Integer
	dim decimalPart as Integer
	dim sSign as String

	sClean = NormalizeDecimalString(sIn)

	v = (Double) sClean

	if digits = 2 then
		factorInt = 100
	elseif digits = 4 then
		factorInt = 10000
	else
		factorInt = 1
	end if


	' Arrondi simple.
	if v >= 0 then
		scaled = (Integer) ((v * factorInt) + 0.5)
	else
		scaled = (Integer) ((v * factorInt) - 0.5)
	end if


	sSign = ""

	if scaled < 0 then
		sSign = "-"
		scaledAbs = -scaled
	else
		scaledAbs = scaled
	end if

	integerPart = IntDiv(scaledAbs, factorInt)
	decimalPart = scaledAbs mod factorInt

	FormatDecimalFrench = sSign & integerPart & "," & PadDigits(decimalPart, digits)

End Function


Function NormalizeDecimalString(sIn as String) as String

	dim sOut as String
	dim c as String
	dim k as Integer

	sOut = ""

	for k = 0 to sIn.length - 1

		c = sIn.GetSubstring(k, 1)

		if c = "," then
			sOut = sOut & "."
		elseif c = " " then
			' on ignore les espaces
		else
			sOut = sOut & c
		end if

	next

	NormalizeDecimalString = sOut

End Function


Function PadDigits(n as Integer, digits as Integer) as String

	dim s as String

	s = "" & n

	do while s.length < digits
		s = "0" & s
	loop

	PadDigits = s

End Function


