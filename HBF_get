'
' IMPORTANT :
' - notation_id est lu par défaut depuis le paramètre String "IdNotation"
' - si un container est renseigné dans le paramètre "notation_id_container",
'   alors ce container devient prioritaire
' - dans ce cas, notation_id est lu depuis la Geometry texte du container
'
' SORTIE :
' - output = geometry text :
'   la valeur choisie est écrite dans geometry.text du container courant
'
' - output = advanced counter :
'   la valeur numérique choisie est envoyée au plugin Advanced_Counter
'   du container courant
'
' - output = Omo :
'   uniquement pour les variations intraday relative et absolute
'   envoie vis_con = 0, 1 ou 2 au plugin Omo selon le signe
'
' - output = active :
'   pour tous les champs sauf Logo : active le container si la valeur est non nulle
'   pour Logo : active le container si le fichier logo existe
'
' - output = non active :
'   logique inverse de output = active
'
' - champ = Logo :
'   en sortie normale, crée la texture logo si le fichier existe,
'   sinon charge une texture vide avec CreateTexture("")
'   en sortie active/non active, ne touche pas à la texture
'   et pilote seulement this.active selon l'existence du fichier
'
' - prices.latest_price :
'   si format_numerique = ,00 ou ,0000, applique le format numérique et le paramètre Suffix
'
' - prices.latest_performance_intraday_absolute :
'   si format_numerique = ,00 ou ,0000, applique le format numérique et le paramètre Suffix
'
' - prices.latest_performance_intraday_relative :
'   si format_numerique = ,00 ou ,0000, multiplie par 100 et ajoute le paramètre Suffix
'
' - format_numerique = majuscule :
'   met la sortie texte en majuscules, sauf champ Logo
'
' - format_numerique = minuscules :
'   met la sortie texte en minuscules, sauf champ Logo
'
' - poser ce script sur un container qui possède une Geometry texte,
'   un plugin Advanced_Counter, un plugin Omo ou une texture selon le mode choisi


' ---------------------------------------------------------------------
' INPUT NOTATION_ID
' ---------------------------------------------------------------------

dim gNotation_id as geometry
dim bUseNotationContainer as boolean


' ---------------------------------------------------------------------
' TABLEAUX DE DONNÉES
' ---------------------------------------------------------------------

dim AsCurrency, AsInstrument, AsMarket, AsNotation, AsPricesGet, AsValueUnit as array[array[string]]
dim sNotationEnCours as string


' ---------------------------------------------------------------------
' TABLE DE CORRESPONDANCE MENU -> DONNÉE
'
' AFieldLabels : texte affiché dans le menu
' AFieldTables : source de données : prices, notation, valueUnit, currency, market, instrument
' AFieldRows   : ligne du tableau
' AFieldCols   : colonne du tableau
' ---------------------------------------------------------------------

dim AFieldLabels as array[string]
dim AFieldTables as array[string]
dim AFieldRows   as array[integer]
dim AFieldCols   as array[integer]

'AFieldFormat vaudra :
'
'0 = champ non concerné
'1 = champ concerné par le format numérique
'2 = champ pourcentage, avec multiplication par 100 si format ,00 ou ,0000

dim AFieldFormat as array[integer]
dim AFormatLabels as array[string]


' ---------------------------------------------------------------------
' OUTPUT
'
' 0 = geometry text
' 1 = advanced counter
' 2 = Omo
' 3 = active
' 4 = non active
' ---------------------------------------------------------------------

dim AOutputLabels as array[string]


' Chemin logo
Dim PathLogo as string = "//rmc.local//donnees//BFMTVVIZ//_NX_CHANNELS//_Channels_Data//B02_BfmBu//Bourses//Logos//Centre//"

' Chemin Logo de developpement -- a supprimer en prod
if system.hostname = "EUCLID" then
	PathLogo = "//quillen//bc//HBF//logo_notation_id//"
end if



' ---------------------------------------------------------------------
' PARAMÈTRES UTILISATEUR
' ---------------------------------------------------------------------

sub OnInitParameters()

	' Méthode alternative : container texte contenant notation_id.
	' Si un container est glissé ici, il devient prioritaire.
	RegisterParameterContainer("notation_id_container", "Notation ID Container")


	' Méthode par défaut : notation_id saisie directement en String.
	' Une chaîne vide = aucune notation_id.
	RegisterParameterString("IdNotation", "Notation ID", "", 40, 100, "")

	BuildFieldList()
	BuildFormatList()
	BuildOutputList()

	' Le 44 correspond à prices.latest_price dans le menu trié alphabétiquement.
	' Largeur 42 caractères, hauteur 24 lignes visibles.
	RegisterParameterDropDown("champ", "Valeur", 44, AFieldLabels, 42, 24)
	
	' Format appliqué seulement aux champs numériques marqués comme formatables.
	RegisterParameterDropDown("format_numerique", "Format", 0, AFormatLabels, 18, 5)

	RegisterParameterString("Suffix", "Suffix", "€", 20, 50, "")

	' Méthode de sortie.
	RegisterParameterDropDown("output", "Sortie", 0, AOutputLabels, 24, 5)
	
	RegisterInfoText("Hub Bourse et Finaances / GetHBF")

end sub


' ---------------------------------------------------------------------
' INIT
' ---------------------------------------------------------------------

sub OnInit()

	if AFieldLabels.size == 0 then
		BuildFieldList()
	end if

	if AFormatLabels.size == 0 then
		BuildFormatList()
	end if

	if AOutputLabels.size == 0 then
		BuildOutputList()
	end if


	UpdateNotationInputMode()

	ClearData()
	RegisterNewNotation()

end sub


' ---------------------------------------------------------------------
' CHANGEMENT DE PARAMÈTRE
' ---------------------------------------------------------------------

sub OnParameterChanged(parameterName As String)

	if parameterName = "notation_id_container" then

		UpdateNotationInputMode()
		RegisterNewNotation()

	elseif parameterName = "IdNotation" then

		' Le paramètre String ne pilote la notation que si aucun container
		' n'est renseigné.
		if bUseNotationContainer = false then
			RegisterNewNotation()
		end if

	elseif parameterName = "champ" then

		OutputSelectedValue()

	elseif parameterName = "format_numerique" then

		OutputSelectedValue()

	elseif parameterName = "Suffix" then

		OutputSelectedValue()

	elseif parameterName = "output" then

		OutputSelectedValue()

	end if

end sub


' ---------------------------------------------------------------------
' SÉLECTION DE LA MÉTHODE D'ENTRÉE NOTATION_ID
'
' Priorité :
' 1. Si notation_id_container est renseigné : Geometry texte du container
' 2. Sinon : paramètre String IdNotation
' ---------------------------------------------------------------------

Sub UpdateNotationInputMode()

	dim cNotationContainer as Container

	bUseNotationContainer = false

	cNotationContainer = GetParameterContainer("notation_id_container")
	if cNotationContainer == null then
		cNotationContainer = this.ParentContainer.Parentcontainer
	end if
	if cNotationContainer <> null then

		gNotation_id = (geometry) cNotationContainer.geometry

		if gNotation_id <> null then
			bUseNotationContainer = true
			gNotation_id.RegisterTextChangedCallback()
		end if

	end if

End Sub


' ---------------------------------------------------------------------
' CHANGEMENT DE GEOMETRY TEXTE DU CONTAINER NOTATION_ID
' ---------------------------------------------------------------------

sub OnGeometryChanged(geom As Geometry)

	' On ne tient compte du changement de géométrie que si la méthode
	' container est active.
	if bUseNotationContainer then
		RegisterNewNotation()
	end if

end sub


' ---------------------------------------------------------------------
' CHANGEMENT SHARED MEMORY
' ---------------------------------------------------------------------

sub OnSharedMemoryVariableChanged(map As SharedMemory, mapKey As String)

	DisplayValue()

end sub


