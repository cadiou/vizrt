' ---------------------------------------------------------------------
' CHANGEMENT DE NOTATION_ID
' ---------------------------------------------------------------------

Sub RegisterNewNotation()

	' On désenregistre les callbacks de l'ancienne notation_id.
	if sNotationEnCours <> "" then
		if AsNotation.size > 0 then
			VizCommunication.Map.UnRegisterChangedCallback("HBF_instrument_" & AsNotation[4][0])
		end if
		VizCommunication.Map.UnRegisterChangedCallback("HBF_prices_get_" & sNotationEnCours)
		VizCommunication.Map.UnRegisterChangedCallback("HBF_notation_"    & sNotationEnCours)
	end if


	' ---------------------------------------------------------
	' Méthode 1 : container texte prioritaire si renseigné
	' ---------------------------------------------------------

	if bUseNotationContainer then

		if gNotation_id <> null then
			sNotationEnCours = gNotation_id.text
			sNotationEnCours.Trim()
		else
			sNotationEnCours = ""
		end if


	' ---------------------------------------------------------
	' Méthode 2 : paramètre String par défaut
	' ---------------------------------------------------------

	else

		sNotationEnCours = GetParameterString("IdNotation")
		sNotationEnCours.Trim()

	end if


	' On enregistre les callbacks de la nouvelle notation_id.
	if sNotationEnCours <> "" then
		VizCommunication.Map.RegisterChangedCallback("HBF_prices_get_" & sNotationEnCours)
		VizCommunication.Map.RegisterChangedCallback("HBF_notation_"    & sNotationEnCours)
	end if

	DisplayValue()

End Sub


' ---------------------------------------------------------------------
' RÉCUPÉRATION DES DONNÉES
' ---------------------------------------------------------------------

Sub DisplayValue()

	AsPricesGet.Clear
	AsNotation.Clear
	AsInstrument.Clear
	AsMarket.Clear
	AsValueUnit.Clear
	AsCurrency.Clear

	' Si aucune notation_id valide n'est définie,
	' on vide simplement la sortie.
	if sNotationEnCours = "" then
		OutputSelectedValue()
		exit sub
	end if


	' Récupération PricesGet et Notation

	AsPricesGet  = (array[array[string]]) VizCommunication.Map["HBF_prices_get_" & sNotationEnCours]
	AsNotation   = (array[array[string]]) VizCommunication.Map["HBF_notation_"   & sNotationEnCours]


	' Récupération ValueUnit / Currency / Market

	if AsPricesGet.size > 0 then

		AsValueUnit = (array[array[string]]) VizCommunication.Map["HBF_valueUnit_" & AsPricesGet[0][0]]
		VizCommunication.Map.RegisterChangedCallback("HBF_valueUnit_" & AsPricesGet[0][0])
		AsCurrency  = (array[array[string]]) VizCommunication.Map["HBF_currency_"  & AsPricesGet[1][0]]
		VizCommunication.Map.RegisterChangedCallback("HBF_currency_"  & AsPricesGet[1][0])
		AsMarket    = (array[array[string]]) VizCommunication.Map["HBF_market_"    & AsPricesGet[2][0]]
		VizCommunication.Map.RegisterChangedCallback("HBF_market_"    & AsPricesGet[2][0])
	else

		if AsNotation.size > 0 then
			AsValueUnit = (array[array[string]]) VizCommunication.Map["HBF_valueUnit_" & AsNotation[2][0]]
			VizCommunication.Map.RegisterChangedCallback("HBF_valueUnit_" & AsNotation[2][0])
			AsMarket    = (array[array[string]]) VizCommunication.Map["HBF_market_"    & AsNotation[3][0]]
			VizCommunication.Map.RegisterChangedCallback("HBF_market_"    & AsNotation[3][0])
		end if

	end if


	' Récupération Instrument

	if AsNotation.size > 0 then
		AsInstrument = (array[array[string]]) VizCommunication.Map["HBF_instrument_" & AsNotation[4][0]]
		VizCommunication.Map.RegisterChangedCallback("HBF_instrument_" & AsNotation[4][0])
	end if


	' Affichage d'une seule valeur

	OutputSelectedValue()

End Sub


' ---------------------------------------------------------------------
' SORTIE UNIQUE SUR LE CONTAINER COURANT
'
' output :
' 0 = geometry text
' 1 = advanced counter
' 2 = Omo
' 3 = active
' 4 = non active
' ---------------------------------------------------------------------

Sub OutputSelectedValue()

	dim iOutput as Integer

	iOutput = GetParameterInt("output")

	' Cas spécial Logo :
	' - la texture est créée si le fichier existe
	' - this.active n'est modifié que pour output = active ou non active
	if IsSelectedField("Logo") then
		OutputSelectedValueToLogo(iOutput)
		exit sub
	end if

	' Outputs qui ne font que gérer this.active.
	' Dans ces deux cas, on ne sort ni texte, ni Advanced_Counter, ni Omo.
	if iOutput = 3 then
		ApplyActiveOutputFromSelectedValue(false)
		exit sub
	elseif iOutput = 4 then
		ApplyActiveOutputFromSelectedValue(true)
		exit sub
	end if

	if iOutput = 2 then
		OutputSelectedValueToOmo()
	elseif iOutput = 1 then
		OutputSelectedValueToAdvancedCounter()
	else
		OutputSelectedValueToGeometryText()
	end if

End Sub


' ---------------------------------------------------------------------
' OUTPUT ACTIVE / NON ACTIVE POUR LES VALEURS NON-LOGO
'
' output = active :
'   valeur 0 ou vide  -> this.active = false
'   autre valeur      -> this.active = true
'
' output = non active :
'   valeur 0 ou vide  -> this.active = true
'   autre valeur      -> this.active = false
' ---------------------------------------------------------------------

Sub ApplyActiveOutputFromSelectedValue(bInvert as Boolean)

	dim bZeroOrEmpty as Boolean

	bZeroOrEmpty = IsSelectedValueZeroOrEmpty()

	if bInvert then

		if bZeroOrEmpty then
			this.active = true
		else
			this.active = false
		end if

	else

		if bZeroOrEmpty then
			this.active = false
		else
			this.active = true
		end if

	end if

End Sub


Function IsSelectedValueZeroOrEmpty() as Boolean

	dim sRawValue as String
	dim sClean as String
	dim dVal as Double

	IsSelectedValueZeroOrEmpty = false

	sRawValue = GetSelectedRawValue()
	sRawValue.Trim()

	if sRawValue = "" then
		IsSelectedValueZeroOrEmpty = true
		exit function
	end if

	if IsNumericText(sRawValue) then

		sClean = NormalizeDecimalString(sRawValue)
		dVal = (Double) sClean

		if Abs(dVal) < 0.0000000001 then
			IsSelectedValueZeroOrEmpty = true
			exit function
		end if

	end if

End Function


' ---------------------------------------------------------------------
' SORTIE GEOMETRY TEXT
' ---------------------------------------------------------------------

' Suffixe commun aux sorties texte et Advanced_Counter.
' Utilisé tel que saisi, espaces compris ; une chaîne vide désactive le suffixe.
Function GetOutputSuffix() as String

	GetOutputSuffix = GetParameterString("Suffix")

End Function


Sub OutputSelectedValueToGeometryText()

	dim sValue as String
	sValue = GetSelectedValue()

	if geometry.text <> sValue then
		geometry.text = sValue
	end if

End Sub


' ---------------------------------------------------------------------
' SORTIE LOGO
'
' Comportement voulu :
' - output normal (geometry text / advanced counter / Omo) :
'     applique la texture si le fichier existe,
'     sinon charge une texture vide avec CreateTexture("")
'
' - output active / non active :
'     ne touche jamais à la texture,
'     pilote seulement this.active selon l'existence du fichier logo
' ---------------------------------------------------------------------

Sub OutputSelectedValueToLogo(iOutput as Integer)

	dim bLogoExists as Boolean

	' Sortie active :
	' logo présent -> this.active = true
	' logo absent  -> this.active = false
	' Aucun changement de texture.
	if iOutput = 3 then
		bLogoExists = LogoFileExists(sNotationEnCours)
		this.active = bLogoExists
		exit sub
	end if

	' Sortie non active :
	' logo présent -> this.active = false
	' logo absent  -> this.active = true
	' Aucun changement de texture.
	if iOutput = 4 then
		bLogoExists = LogoFileExists(sNotationEnCours)
		this.active = Not bLogoExists
		exit sub
	end if

	' Sorties normales :
	' on applique la texture si elle existe,
	' sinon on charge une texture vide.
	bLogoExists = Set_Logo(this, sNotationEnCours)

End Sub


' ---------------------------------------------------------------------
' SORTIE ADVANCED COUNTER
'
' Important :
' - cette sortie ne concerne que les valeurs numériques
' - si la valeur choisie n'est pas numérique, on retombe en geometry.text
'   pour éviter une sortie vide incompréhensible
' ---------------------------------------------------------------------

Sub OutputSelectedValueToAdvancedCounter()

	dim sRawValue as String
	dim sTextValue as String
	dim sClean as String
	dim dVal as Double
	dim sSuffix as String
	dim iFieldFormat as Integer

	sRawValue = GetSelectedRawValue()
	sTextValue = GetSelectedValue()

	' Si la valeur n'est pas numérique, Advanced_Counter ne peut pas l'afficher.
	' On utilise alors la sortie texte classique.
	if IsNumericText(sRawValue) = false then

		if geometry.text <> sTextValue then
			geometry.text = sTextValue
		end if

		exit sub

	end if

	sClean = NormalizeDecimalString(sRawValue)
	dVal = (Double) sClean

	sSuffix = GetOutputSuffix()

	iFieldFormat = GetSelectedFieldFormat()


	' ---------------------------------------------------------
	' Performance relative
	'
	' prices.latest_performance_intraday_relative
	'
	' - format exact : valeur brute avec le paramètre Suffix
	' - format ,00 ou ,0000 : x100 + paramètre Suffix
	' ---------------------------------------------------------

	if iFieldFormat = 2 then

		if IsDecimalFormatSelected() then
			dVal = dVal * 100.0
		end if

	end if


	' Le paramètre Suffix est transmis au mask Advanced_Counter.

	PushNumberToCtn(this, dVal, sSuffix)

End Sub


' ---------------------------------------------------------------------
' SORTIE OMO
'
' Ne fonctionne que pour :
' - prices.latest_performance_intraday_relative
' - prices.latest_performance_intraday_absolute
'
' X :
' 0 = négatif
' 1 = nul
' 2 = positif
' ---------------------------------------------------------------------

Sub OutputSelectedValueToOmo()

	dim sRawValue as String
	dim sClean as String
	dim dVal as Double
	dim iVisCon as Integer

	' Sortie inactive pour tous les autres champs.
	if SelectedFieldUsesOmoOutput() = false then
		exit sub
	end if

	sRawValue = GetSelectedRawValue()

	if IsNumericText(sRawValue) = false then
		exit sub
	end if

	sClean = NormalizeDecimalString(sRawValue)
	dVal = (Double) sClean

	if Abs(dVal) < 0.0000000001 then
		iVisCon = 1
	elseif dVal < 0.0 then
		iVisCon = 0
	else
		iVisCon = 2
	end if

	this.GetFunctionPluginInstance("Omo").SetParameterInt("vis_con", iVisCon)

End Sub


' ---------------------------------------------------------------------
' RÉCUPÉRATION DE LA VALEUR CHOISIE FORMATÉE
' ---------------------------------------------------------------------

Function GetSelectedValue() as String

	dim sValue as String
	dim iSelected as Integer

	sValue = GetSelectedRawValue()

	if AFieldLabels.size == 0 then
		GetSelectedValue = ""
		exit function
	end if

	iSelected = GetParameterInt("champ")

	if iSelected < 0 then
		GetSelectedValue = ""
		exit function
	end if

	if iSelected >= AFieldLabels.size then
		GetSelectedValue = ""
		exit function
	end if


	' Application du format numérique seulement aux champs marqués.
	if AFieldFormat[iSelected] = 1 then

		' Format numérique simple.
		' Plus aucun suffixe valueUnit.editorialName.
		sValue = FormatNumericValue(sValue)

	elseif AFieldFormat[iSelected] = 2 then

		' Performance relative :
		' garde la conversion x100 uniquement pour ,00 / ,0000.
		sValue = FormatNumericPercentValue(sValue)

	end if

	' Suffixe uniquement pour les valeurs numériques aux formats ,00 / ,0000.
	if IsDecimalFormatSelected() then
		if AFieldFormat[iSelected] = 1 or AFieldFormat[iSelected] = 2 then
			if IsNumericText(sValue) then
				sValue = sValue & GetOutputSuffix()
			end if
		end if
	end if

