' ---------------------------------------------------------------------
' PROCESS ADVANCED_COUNTER
'
' Formatage du mask Advanced_Counter en rapport avec la valeur Double
'
' Ctn    = Container cible équipé d'un Advanced_Counter
' dVal   = valeur Double à intégrer
' Suffix = suffixe à intégrer au mask, exemple " %"
' ---------------------------------------------------------------------

Sub PushNumberToCtn(ByVal Ctn As Container, ByVal dVal As Double, ByVal Suffix As String)

	Dim MaskFull As String
	Dim DigitCount As Integer
	Dim x As Integer
	Dim iDecimalCount As Integer

	MaskFull = ""

	' Test de la valeur dVal si proche de 0.00009 = 0.0000
	If Abs(dVal) < 0.00009 Then
		dVal = 0.0000
	End If

	' Formatage du mask : partie entière de la valeur
	DigitCount = 0

	For x = 1 to Len(CStr(Abs(CInt(dVal))))

		DigitCount = DigitCount + 1

		If DigitCount = 4 Then
			MaskFull = "# " & MaskFull
			DigitCount = 1
		Else
			MaskFull = "#" & MaskFull
		End If	

	Next

	' Traitement des décimales
	iDecimalCount = GetAdvancedCounterDecimalCount()

	If iDecimalCount <> 0 Then

		MaskFull = MaskFull & "."

		For x = 1 to iDecimalCount
			MaskFull = MaskFull & "#"
		Next		

	End If

	' Traitement du prefix : espace entre prefix + ou - et valeur
	' Option plugin : "Force prefix" est True/False
	If Ctn.GetFunctionPluginInstance("Advanced_Counter").GetParameterBool("fprefix") Then

		If dVal <> 0.0000 Then
			MaskFull = "# " & MaskFull
		End If

	End If

	' Intégration du MASK + suffix
	Ctn.GetFunctionPluginInstance("Advanced_Counter").SetParameterString("inpmask", MaskFull & Suffix)

	' Intégration de la valeur Double
	' Exemple attendu : -12345.987 -> - 12 345.98 %
	Ctn.GetFunctionPluginInstance("Advanced_Counter").SetParameterDouble("fnumber", dVal)

End Sub


